   "top": 995,
   "h": 23,
   "style": "cb7f88c0",
   "text": "安全约束§"
  },
  {
   "slot": 15,
   "kind": "listItem",
   "top": 1027,
   "h": 52,
   "style": "a390f43a",
   "text": "敏感数据（OAuth token、refreshToken、credentials）必须 AES"
  },
  {
   "slot": 16,
   "kind": "listItem",
   "top": 1081,
   "h": 29,
   "style": "086a5fd0",
   "text": "API Key 使用 SHA-256 哈希存储，禁止明文"
  },
  {
   "slot": 17,
   "kind": "listItem",
   "top": 1112,
   "h": 29,
   "style": "9378b22b",
   "text": "每个请求必须经过完整认证链（API Key → 权限 → 客户端限制 → 模型黑名单）"
  },
  {
   "slot": 18,
   "kind": "listItem",
   "top": 1143,
   "h": 29,
   "style": "186cb797",
   "text": "客户端断开时必须通过 AbortController 清理资源和并发计数"
  },
  {
   "slot": 19,
   "kind": "listItem",
   "top": 1174,
   "h": 29,
   "style": "d3665598",
   "text": "日志中禁止输出完整 token，使用 tokenMask.js 脱敏"
  },
  {
