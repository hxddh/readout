   "kind": "code",
   "top": 1183,
   "h": 450,
   "style": "2e6218c6",
   "content": "51f3acfb",
   "text": "src/ ├── routes/ # HTTP 路由 │ ├── api.js # Claude"
  },
  {
   "slot": 22,
   "kind": "heading",
   "top": 1633,
   "h": 65,
   "style": "2e0327d8",
   "content": "921bf9b9",
   "text": "核心请求流程"
  },
  {
   "slot": 23,
   "kind": "code",
   "top": 1698,
   "h": 122,
   "style": "6bf08a46",
   "content": "7ded657e",
   "text": "客户端(cr_前缀Key) → 路由 → auth中间件(验证/权限/限流/模型黑名单) → 统"
  },
  {
   "slot": 24,
   "kind": "paragraph",
   "top": 1820,
   "h": 34,
   "style": "825fa951",
   "content": "30048bba",
   "text": "关键机制："
  },
  {
   "slot": 25,
   "kind": "listItem",
   "top": 1855,
   "h": 31,
   "style": "fc1945dc",
   "content": "86de3b94",
