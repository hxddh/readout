   "text": "代码风格"
  },
  {
   "slot": 32,
   "kind": "listItem",
   "top": 2132,
   "h": 31,
   "style": "ff887e8b",
   "content": "7de688ee",
   "text": "无分号、单引号、100字符行宽、尾逗号 none、箭头函数始终加括号"
