  },
  {
   "slot": 26,
   "kind": "listItem",
   "top": 1885,
   "h": 31,
   "style": "280a2ce0",
   "content": "6ab8a043",
   "text": "并发控制: Redis Sorted Set 实现，支持排队等待（非直接 429）"
