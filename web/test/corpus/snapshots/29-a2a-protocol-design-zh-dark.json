   "slot": 7,
   "kind": "listItem",
   "top": 389,
   "h": 31,
   "style": "5e5a1484",
   "content": "0a53552c",
   "text": "最小侵入：通过 MessageBus 元数据标记和路由扩展集成，不修改现有消息流核心逻辑"
  },
  {
   "slot": 8,
   "kind": "listItem",
   "top": 420,
   "h": 47,
   "style": "2ce8c30d",
   "content": "023b1405",
