#!/bin/sh
# readout — open Markdown files in Readout.
#
#   readout FILE...            open files and bring Readout forward
#   readout FILE.md#section    open a file at a section
#   readout FOLDER             open the newest Markdown file in a folder
#   readout -b FILE...         open files (or a folder's newest, or FILE.md#section) in the
#                              background, behind the one you are reading
#   readout --hook             for agent hooks: read hook JSON on stdin and open
#                              tool_input.file_path (Cursor: file_path) in the background
#                              if it is Markdown (paths in it are also looked up in the
#                              hook's cwd, or Cursor's first workspace root)
#   readout --version          print Readout's version
#
# Bundle identifier of the Readout app.
APP_ID="io.github.hxddh.readout"
OPEN="${READOUT_OPEN_COMMAND:-/usr/bin/open}"

usage() {
  sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'
}

is_markdown() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.md|*.markdown|*.mdown|*.mkd|*.mkdn|*.mdwn|*.mdtxt|*.mdtext) return 0 ;;
    *) return 1 ;;
  esac
}

# Every byte percent-encoded.
encode() {
  printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n' | sed 's/../%&/g'
}

absolute() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s' "$PWD/$1" ;;
  esac
}

# readout-open://open?background=1&path=<absolute path, every byte percent-encoded>.
# `open -g` alone only keeps Readout from activating: the file would still be
# opened as a request and its tab brought to the front. The URL asks Readout to
# leave the tab being read alone. A second argument, an existing absolute
# folder, goes along as `root`: the project the file's paths are relative to.
background_url() {
  printf 'readout-open://open?background=1&path=%s' "$(encode "$(absolute "$1")")"
  case "$2" in
    /*) [ -d "$2" ] && printf '&root=%s' "$(encode "$2")" ;;
  esac
  return 0
}

# A file at a section (`plan.md#risks`): Launch Services drops a file URL's fragment.
anchor_url() {
  printf 'readout-open://open?path=%s&anchor=%s' "$(encode "$(absolute "$1")")" "$(encode "$2")"
}

# The most recently modified Markdown file directly in a folder.
newest_markdown() {
  dir=${1%/}
  [ -n "$dir" ] || dir=/
  ls -t -- "$dir" 2>/dev/null | while IFS= read -r name; do
    if is_markdown "$name" && [ -f "$dir/$name" ]; then
      printf '%s\n' "$dir/$name"
      break
    fi
  done
}

# CFBundleShortVersionString of the Readout.app this script is in (through a
# symlink such as ~/.local/bin/readout), else of the installed one.
version() {
  self=$0
  while [ -L "$self" ]; do
    link=$(readlink "$self")
    case "$link" in
      /*) self=$link ;;
      *) self=$(dirname "$self")/$link ;;
    esac
  done
  plist="$(dirname "$self")/../Info.plist"
  if [ ! -f "$plist" ] && [ -x /usr/bin/mdfind ]; then
    app=$(/usr/bin/mdfind "kMDItemCFBundleIdentifier == '$APP_ID'" 2>/dev/null | head -n 1)
    [ -n "$app" ] && plist="$app/Contents/Info.plist"
  fi
  [ -f "$plist" ] || return 1
  v=""
  # macOS's plutil (binary or XML); another system's plutil may not know -extract.
  [ "$(uname)" = Darwin ] && v=$(/usr/bin/plutil -extract CFBundleShortVersionString raw -o - "$plist" 2>/dev/null)
  # An XML property list without plutil.
  [ -n "$v" ] || v=$(sed -n '/<key>CFBundleShortVersionString<\/key>/{n;s/.*<string>\(.*\)<\/string>.*/\1/p;}' "$plist")
  [ -n "$v" ] && printf '%s\n' "$v"
}

case "$1" in
  -h|--help) usage; exit 0 ;;
  -v|--version)
    v=$(version) || v=""
    [ -n "$v" ] || { echo "readout: Readout.app not found" >&2; exit 1; }
    echo "readout $v"
    exit 0 ;;
  --hook)
    input=$(cat)
    # Claude Code and Gemini CLI: tool_input.file_path; Cursor's afterFileEdit: file_path.
    path=$(printf '%s' "$input" | /usr/bin/plutil -extract tool_input.file_path raw -o - - 2>/dev/null) ||
      path=$(printf '%s' "$input" | /usr/bin/plutil -extract file_path raw -o - - 2>/dev/null)
    # The folder the agent works in: plans (~/.claude/plans) name paths relative to it.
    # Cursor names its workspace folders instead, the first one first.
    root=$(printf '%s' "$input" | /usr/bin/plutil -extract cwd raw -o - - 2>/dev/null) ||
      root=$(printf '%s' "$input" | /usr/bin/plutil -extract workspace_roots.0 raw -o - - 2>/dev/null)
    [ -n "$path" ] && is_markdown "$path" && [ -f "$path" ] && exec "$OPEN" -g -b "$APP_ID" "$(background_url "$path" "$root")"
    exit 0 ;;
  -b|--background)
    shift
    [ "$1" = "--" ] && shift
    status=0
    for f do
      shift
      if [ -d "$f" ]; then
        newest=$(newest_markdown "$f")
        if [ -n "$newest" ]; then
          set -- "$@" "$(background_url "$newest")"
        else
          echo "readout: $f: No Markdown files in this folder" >&2
          status=1
        fi
      elif [ -f "$f" ]; then
        set -- "$@" "$(background_url "$f")"
      elif [ "${f%#*}" != "$f" ] && [ -f "${f%#*}" ] && is_markdown "${f%#*}"; then
        set -- "$@" "$(background_url "${f%#*}")&anchor=$(encode "${f##*#}")"
      else
        echo "readout: $f: No such file" >&2
        status=1
      fi
    done
    [ $# -gt 0 ] || exit "$status"
    # Not exec: a skipped file still makes the command fail.
    "$OPEN" -g -b "$APP_ID" "$@" || status=$?
    exit "$status" ;;
  "") exec "$OPEN" -b "$APP_ID" ;;
  *)
    [ "$1" = "--" ] && shift
    status=0
    anchored=0
    for f do
      shift
      if [ -d "$f" ]; then
        newest=$(newest_markdown "$f")
        if [ -n "$newest" ]; then
          set -- "$@" "$newest"
        else
          echo "readout: $f: No Markdown files in this folder" >&2
          status=1
        fi
      elif [ ! -e "$f" ] && [ "${f%#*}" != "$f" ] && [ -f "${f%#*}" ] && is_markdown "${f%#*}"; then
        set -- "$@" "$(anchor_url "${f%#*}" "${f##*#}")"
        anchored=1
      else
        set -- "$@" "$f"
      fi
    done
    [ $# -gt 0 ] || exit "$status"
    if [ "$anchored" = 0 ]; then
      "$OPEN" -b "$APP_ID" -- "$@" || status=$?
    else
      # One at a time, in order: the last one ends up in front, as with files alone.
      for f do
        case "$f" in
          readout-open://*) "$OPEN" -b "$APP_ID" "$f" || status=$? ;;
          *) "$OPEN" -b "$APP_ID" -- "$f" || status=$? ;;
        esac
      done
    fi
    exit "$status" ;;
esac
